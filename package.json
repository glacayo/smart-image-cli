{
  "name": "smart-image-cli",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for analyzing, organizing, and preparing website image assets.",
  "type": "module",
  "bin": {
    "img": "./dist/cli/program.js"
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --check \"*.{json,js,ts}\" \"assets/**/*.json\" \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
