{
  "name": "smart-image-cli",
  "version": "0.3.0",
  "description": "Agent-friendly CLI for analyzing, organizing, and preparing website image assets.",
  "type": "module",
  "bin": {
    "smart-img": "dist/cli/program.js",
    "img": "dist/cli/output.js"
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check \"*.{json,js,ts}\" \"assets/**/*.json\" \"src/**/*.ts\"",
    "openspec:validate": "node scripts/openspec-validate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "commander": "^12.1.0",
    "exiftool-vendored": "^37.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glacayo/smart-image-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/glacayo/smart-image-cli/issues"
  },
  "homepage": "https://github.com/glacayo/smart-image-cli#readme"
}
